{
  "name": "saga-lightning-warrior",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "assets": "node tools/asset-pipeline/index.mjs",
    "assets:preview": "node tools/asset-pipeline/preview-maps.mjs --scale 0.3",
    "ci": "tsc --noEmit && node tools/asset-pipeline/validate-maps.mjs && vite build",
    "assets:validate": "node tools/asset-pipeline/validate-maps.mjs"
  },
  "dependencies": {
    "phaser": "^3.60.0"
  },
  "devDependencies": {
    "typescript": "^5.0.0",
    "vite": "^5.0.0"
  }
}
